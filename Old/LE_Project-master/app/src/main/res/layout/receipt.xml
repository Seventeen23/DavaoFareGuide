<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/receipt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Receipt"
            android:textSize="30dp"
            android:textColor="#000000" />

        <ImageButton
            android:id="@+id/receipt_x_button"
            android:layout_width="40dp"
            android:layout_height="match_parent"

            android:background="@drawable/exit" />

    </LinearLayout>

    <TextView
        android:id="@+id/receipt_from_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="From: another text here"
        android:textColor="#000000"
        android:textSize="20dp" />

    <TextView
        android:id="@+id/receipt_to_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="To: another text here"
        android:textColor="#000000"
        android:textSize="20dp" />

    <TextView
        android:id="@+id/receipt_jeepney_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Jeepney: another text here"
        android:textColor="#000000"
        android:textSize="20dp" />

    <TextView
        android:id="@+id/receipt_fee_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Fee: another text        another text"
        android:textColor="#000000"
        android:textSize="20dp" />

    <TextView
        android:id="@+id/receipt_kilomter_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Kilometers: another text        another text"
        android:textColor="#000000"
        android:textSize="20dp" />

    <Button
        android:id="@+id/receipt_save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:backgroundTint="#9A26B561"
        android:fontFamily="@font/glacial"
        android:text="RECORD FARE"
        android:textColor="#FFFFFF" />

</LinearLayout>