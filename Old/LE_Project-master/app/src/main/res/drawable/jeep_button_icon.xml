<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/grad_blue"
                android:endColor="@color/grad_green"
                android:type="linear"
                />
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item
        android:left="20dp"
        android:right="20dp"
        android:top="20dp"
        android:bottom="20dp">

        <bitmap
            android:src="@drawable/rightarrow"

            android:gravity="right"/>
    </item>
</layer-list>